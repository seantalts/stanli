// Enough to lower on both sides of write_array and log_prob that lowering
// them on two threads pays.
data {
  int<lower=1> N;
  vector[N] y;
}
parameters {
  real mu;
  real<lower=0> sigma;
}
model {
  for (n in 1:N) y[n] ~ normal(mu, sigma);
  mu ~ normal(0, 5);
  sigma ~ normal(0, 5);
}
generated quantities {
  vector[N] y_rep;
  vector[N] log_lik;
  for (n in 1:N) {
    y_rep[n] = normal_rng(mu, sigma);
    log_lik[n] = normal_lpdf(y[n] | mu, sigma);
  }
}


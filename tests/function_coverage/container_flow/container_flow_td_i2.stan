    int n = 0;
    for (t in 1:td_i2_reads[2, 3]) n += 1;
    td_i2_reads__gq_loop = n;
  }
  {
    td_i2_reads__gq_index = w[td_i2_reads[2, 3]];
  }
  {
    td_i2_reads__gq_gather = dot_product(w[td_i2_reads[2]], ramp4);
  }
  {
    td_i2_reads__gq_size = size(td_i2_reads);
  }
  {
    array[2] int dd = dims(td_i2_reads);
    int s = 0;
    for (t in 1:size(dd)) s = s * 10 + dd[t];
    td_i2_reads__gq_dims = s;
  }
  {
    array[4] int cp = td_i2_reads[2];
    td_i2_reads__gq_rowcopy = cp[3];
  }
  {
    array[3] int cp = td_i2_reads[:, 3];
    td_i2_reads__gq_colcopy = cp[2];
  }
}

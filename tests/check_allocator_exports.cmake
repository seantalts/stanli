if(PLATFORM STREQUAL "Darwin")
  execute_process(COMMAND "${NM}" -gU "${LIBRARY}"
    RESULT_VARIABLE result OUTPUT_VARIABLE symbols)
elseif(PLATFORM STREQUAL "Windows")
  execute_process(COMMAND "${OBJDUMP}" -p "${LIBRARY}"
    RESULT_VARIABLE result OUTPUT_VARIABLE dump)
  string(REPLACE "\r" "" dump "${dump}")
  # Only the PE export name table, never the imports or relocation symbols.
  string(REGEX MATCH "\\[Ordinal/Name Pointer\\] Table[^\r]*" symbols "${dump}")
  string(REGEX REPLACE "The Function Table.*" "" symbols "${symbols}")
  if(NOT symbols)
    # LLVM objdump uses a different, compact PE export table.
    string(REGEX MATCH "Export Table:[^\r]*" symbols "${dump}")
  endif()
else()
  execute_process(COMMAND "${NM}" -D --defined-only "${LIBRARY}"
    RESULT_VARIABLE result OUTPUT_VARIABLE symbols)
endif()
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot inspect shipping allocator exports")
endif()
string(REPLACE "\n" ";" lines "${symbols}")
if(PROBE)
  set(allowed "^allocator_test_")
  set(required "allocator_test_alloc")
else()
  set(allowed "^(stanli_|bs_)")
  set(required "stanli_build_id")
endif()
foreach(line IN LISTS lines)
  set(name "")
  if(PLATFORM STREQUAL "Windows")
    if(line MATCHES "^[ \t]*\\[[ \t]*[0-9]+\\][ \t]+([^ \t]+)")
      set(name "${CMAKE_MATCH_1}")
    elseif(line MATCHES "^[ \t]*[0-9]+[ \t]+0x[0-9a-fA-F]+[ \t]+([^ \t]+)")
      set(name "${CMAKE_MATCH_1}")
    endif()
  elseif(line MATCHES "[ \t]([^ \t]+)$")
    set(name "${CMAKE_MATCH_1}")
    if(PLATFORM STREQUAL "Darwin")
      string(REGEX REPLACE "^_" "" name "${name}")
    endif()
  endif()
  if(name AND (NOT name MATCHES "${allowed}" OR
     (NOT PROBE AND name MATCHES "allocator_(test|probe)")))
    message(FATAL_ERROR "Unexpected shipping export: ${name}")
  endif()
endforeach()
if(NOT symbols MATCHES "${required}")
  message(FATAL_ERROR "Shipping API missing from export check")
endif()

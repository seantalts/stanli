deps/*
!deps/fetch.sh
build/
build-rel/
# Every out-of-source tree: build-lite, build-ship, whatever a
# measurement needs next. Named entries above are kept for clarity.
build-*/
python/stanli/_bin/
# The conformance reference client, version-pinned separately from whatever
# python3 the host happens to have (tools/dev_setup.sh --conformance).
.venv-conformance/
dist/
*.egg-info/
compile_commands.json
python/stanli/LICENSE
python/stanli/THIRD_PARTY_LICENSES.md
.cache/
conformance-out/
# Conformance reports, snapshots, reproducers, and retained generated shards
# are run artifacts. Keep even manually redirected outputs out of source.
harnesses/conformance/conformance-baseline.json
harnesses/conformance/conformance.json
harnesses/conformance/unsupported.md
harnesses/conformance/signatures.txt
harnesses/conformance/repro/
harnesses/conformance/generated/
tests/fixtures/*.hpp
tests/stanc3/*.hpp
build-wasm/
web/stanli.js
web/stanli.wasm
web/stancjs.bc.js
js/stanli.js
js/stanli.wasm
js/stancjs.bc.js
web/worker.js
web/stanli.mjs
# The corpus the demo page offers: 8 MB of posteriordb models and data,
# written by tools/gen_web_models.py from the pinned checkout. Generated
# rather than committed, for the same reason the wasm is.
web/models/
*.tgz
r/src/*.o
r/src/*.so
r/src/*.dll
r/*.Rcheck/
r/*.tar.gz
.claude/worktrees/

# Python bytecode, and the model libraries reference BridgeStan
# compiles next to a .stan file when the conformance harness runs.
__pycache__/
*.py[cod]
tests/fixtures/*_model.so
tests/fixtures/*.hpp
conformance-cache/

# harnesses/model_census.py run artifacts: the invented data and CmdStan
# reference values it caches content-addressed (once per model ever), and
# the report it writes. The cache is a rerun's determinism, not a source.
# No trailing slash: a worktree usually symlinks the cache in from a
# sibling checkout rather than growing its own, and a `dir/` rule does not
# match a symlink.
model-census-cache
model-census.json

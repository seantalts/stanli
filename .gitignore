deps/*
!deps/fetch.sh
!deps/pins.env
build/
build-rel/
# Every out-of-source tree: build-lite, build-ship, whatever a
# measurement needs next. Named entries above are kept for clarity.
build-*/
# CmdStan reference binaries of tools/gen_stanc3_good_data.py and
# tools/check_stanc3_good.py --record.
build-stanc3-ref/
python/stanli/_bin/
# The conformance reference client, version-pinned separately from whatever
# python3 the host happens to have (tools/dev_setup.sh --conformance).
.venv-conformance/
dist/
*.egg-info/
compile_commands.json
python/stanli/LICENSE
python/stanli/THIRD_PARTY_LICENSES.md
.cache/
conformance-out/
# Conformance reports, snapshots, reproducers, and retained generated shards
# are run artifacts. Keep even manually redirected outputs out of source.
harnesses/conformance/conformance-baseline.json
harnesses/conformance/conformance.json
harnesses/conformance/unsupported.md
harnesses/conformance/signatures.txt
harnesses/conformance/repro/
harnesses/conformance/generated/
tests/fixtures/*.hpp
tests/fixtures/*.tmir.sexp
tests/fixtures/builtin_signatures_*.stan
tests/fixtures/density_signatures_*.stan
tests/regressions/*.hpp
tests/stanc3_good/overrides/*.hpp
tests/brms/*.hpp
build-wasm/
web/stanli.js
web/stanli.wasm
web/stancjs.bc.js
web/stanli-compiler.js
js/stanli.js
js/stanli.wasm
js/stancjs.bc.js
js/stanli-compiler.js
web/worker.js
web/stanli.mjs
# The corpus the demo page offers: 8 MB of posteriordb models and data,
# written by tools/gen_web_models.py from the pinned checkout. Generated
# rather than committed, for the same reason the wasm is.
web/models/
*.tgz
r/src/*.o
r/src/*.so
r/src/*.dll
r/*.Rcheck/
r/*.tar.gz
.claude/worktrees/

# Python bytecode, and the model libraries reference BridgeStan
# compiles next to a .stan file when the conformance harness runs.
__pycache__/
*.py[cod]
tests/fixtures/*_model.so
tests/fixtures/*.hpp
tests/fixtures/*.o
conformance-cache/

/tests/function_coverage/*.hpp
/tests/function_coverage/container_flow/*.hpp
tests/oncobayes2/*.hpp

# Compiler output beside generated teaching fixtures.
tests/rethinking/*.hpp

# Keep exploratory benchmark artifacts local; publish their summaries in docs/.
/output/teaching-performance/followup-*/
tests/cogmod/*.hpp

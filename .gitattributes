.gitattributes text eol=lf
compiler/js/* text eol=lf
compiler/ocaml/* text eol=lf
tools/build_wheel.sh text eol=lf
tools/dev_setup.sh text eol=lf
tools/dev_setup_windows.sh text eol=lf
deps/fetch.sh text eol=lf
deps/pins.env text eol=lf
tools/build_jobs.sh text eol=lf
harnesses/conformance/build_stanc.sh text eol=lf
harnesses/conformance/fetch_cmdstan.sh text eol=lf
tools/stanc_embed/* text eol=lf
tests/test_windows_provenance.sh text eol=lf

# Preserve generator output exactly, including its whitespace and line endings.
tests/rethinking/*.stan -text whitespace=-blank-at-eol,-blank-at-eof
output/pdf/*.pdf binary
output/rethinking-report/*.csv -text whitespace=cr-at-eol
# Frozen diagnostic inputs and raw tables retain their measured bytes.
harnesses/diagnostics/fixtures/covariance_*.stan -text whitespace=-blank-at-eol,-blank-at-eof
notes/performance/data/2026-11-23-forward-loop-storage/*.tsv -text whitespace=-blank-at-eol,cr-at-eol
notes/triage/data/*.log -text whitespace=-blank-at-eol
# Fuzz inputs are bytes: a line-ending conversion would change them.
tests/fuzz/corpus/** -text

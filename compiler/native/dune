(library
 (name stanli_native_compiler)
 (wrapped false)
 (modules portable_mir stanli_pipeline)
 (libraries fmt common frontend middle driver analysis_and_optimization))

(executable
 (name stanc_embed)
 (modes object)
 (modules stanc_embed)
 (libraries
  threads
  stanli_native_compiler
  fmt
  common
  frontend
  middle
  driver
  analysis_and_optimization)
 ; -runtime-variant _pic: link the PIC build of the OCaml runtime
 ; (libasmrun_pic.a). The default runtime carries R_X86_64_32 absolute
 ; relocations, which the linker rejects inside a shared object on Linux.
 ; Windows uses the default runtime; it does not provide the _pic variant.
 (link_flags
  (-runtime-variant "%{env:STANLI_OCAML_RUNTIME_VARIANT=_pic}"
   -output-complete-obj -cclib
   -L%{env:STANLI_OCAML_SYSTEM_LIBDIR=.})))

(test
 (name stanli_pipeline_tests)
 (modules stanli_pipeline_tests)
 (libraries stanli_native_compiler middle))

; Measurement-only source-pass probe. It is copied beside the compiler build
; for corpus experiments but is not linked into, installed with, or selected
; by any shipping producer.

(executable
 (name stanli_vectorize_probe)
 (modules stanli_vectorize_probe)
 (libraries stanli_native_compiler fmt common frontend))

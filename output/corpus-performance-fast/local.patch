+  const auto measured = stanli_benchmark::window(one, opts.measure_ns, warm.batch);
+  std::cout << "{\"opcode\":\"" << opcode_name(op.opcode)
+            << "\",\"variant\":" << unsigned(op.variant) << ",\"lens\":[";
+  for (int i = 0; i < op.n_in; ++i)

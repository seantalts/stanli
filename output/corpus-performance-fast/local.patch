+    std::ostringstream s;
+    s << f.rdbuf();
+    return s.str();
+  };
+  auto cm = compile_model(slurp(argv[2]), DataMap::from_json(slurp(argv[3])));
+  Executor ex(std::move(cm.graph));
+  cm.bind(ex);
+  for (int64_t i = 0; i < ex.n_params(); ++i)
+    ex.params_data()[i] = 0.1 + 0.05 * (i % 7) - 0.15 * (i % 3);
+  ex.forward();
+  const Graph& g = ex.graph();
+  const Op& op = g.ops.at(static_cast<size_t>(std::stoul(argv[4])));
+  const Kernel& k = kernel(op.opcode);
+  if (!k.forward || k.make_state || op.dyn_capacity)
+    throw std::invalid_argument("kernel needs state or dynamic extents");
+  KernelCtx ctx{};
+  ctx.n_in = op.n_in;
+  ctx.variant = op.variant;
+  ctx.idata = op.idata;
+  ctx.n_idata = op.n_idata;
+  ctx.udata = op.udata;
+  for (int i = 0; i < op.n_in; ++i)
+    ctx.in[i] = {ex.value_ptr(op.in[i]), g.slots[op.in[i]].len};
+  const int64_t n = g.slots[op.out].len;
+  std::vector<double> out(static_cast<size_t>(n));
+  std::vector<double> out2(op.out2 < 0 ? 0 : g.slots[op.out2].len);
+  std::vector<double> scratch(k.scratch_size ? k.scratch_size(op, g.slots.data()) : 0);
+  ctx.out = {out.data(), n};
+  ctx.out2 = {out2.data(), static_cast<int64_t>(out2.size())};
+  ctx.scratch = scratch.data();
+  k.forward(ctx);
+  for (int64_t i = 0; i < n; ++i)

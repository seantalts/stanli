+def _log_inv_Phi(logp):
+    if mp.isnan(logp):
+        return mp.nan
+    if logp > 0:
+        raise StanReject("normal log quantile probability exceeds zero")
+    if logp == 0:
+        return mp.inf
+    if logp == -mp.inf:
+        return -mp.inf
+    if logp > -mp.log(2):
+        return -_log_inv_Phi(mp.log(-mp.expm1(logp)))
+    if logp > -(mp.dps // 2) * mp.log(10):
+        return _inv_Phi(mp.exp(logp))
+    # In the far tail, forming 2*p-1 loses p even at arbitrary precision.
+    start = -mp.sqrt(-2 * logp)
+    return mp.findroot(lambda z: mp.log(Phi(z)) - logp, (start, start + 1))
+
+
+def _inv_erfc(p):
+    if p < 0 or p > 2:
+        raise StanReject("inverse erfc argument outside [0,2]")
+    return -_log_inv_Phi(mp.log(p / 2)) / mp.sqrt(2)
+

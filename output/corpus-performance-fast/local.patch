+std::optional<double> density_data_constant(const DensitySpec& spec,
+                                           const DensityCallPlan& plan) {
+  // poisson_log_glm's propto form drops only this outcome normalization:
+  // its real operands remain recorder scalars/vectors in both forms.
+  if (spec.opcode != OP_POISSON_LOG_GLM_LPMF || (plan.variant & 0x80u) ||
+      plan.empty_result || plan.idata.size() < 2)
+    return std::nullopt;
+  const size_t size = plan.idata.size();
+  const bool scalar_layout = size >= 4 &&
+      plan.idata[size - 2] == kGlmScalarLayoutMarker;
+  const size_t tail = scalar_layout ? 4 : 2;
+  const int rows = plan.idata[size - tail];
+  const bool scalar_y = scalar_layout && (plan.idata.back() & 1);
+  const int ny = scalar_y ? 1 : rows;
+  // Amortize the extra scalar graph addition; leave small calls unchanged.
+  if (ny < 16 || size != static_cast<size_t>(ny) + tail)
+    return std::nullopt;
+  for (int i = 0; i < ny; ++i)
+    if (plan.idata[i] < 0 || plan.idata[i] == std::numeric_limits<int>::max())
+      return std::nullopt;  // keep support checks and integer +1 on fallback
+  double constant = 0;
+  if (scalar_y) {
+    constant -= stan::math::lgamma(plan.idata[0] + 1);
+  } else {
+    const Eigen::Map<const Eigen::VectorXi> y(plan.idata.data(), ny);
+    constant -= stan::math::sum(stan::math::lgamma(y.array() + 1));
+  }
+  return constant;
+}
+

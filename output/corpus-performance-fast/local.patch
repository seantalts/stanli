+// Both recorder-backed density families consume retained partials. Exercise
+// independent scratch/adjoint alignment, packet boundaries, repeated seeds,
+// and disconnected edges without rerunning a forward density (which could
+// hide a bad pullback by replacing its scratch).
+static void check_retained_density_pullbacks() {
+  using namespace stanli;
+  const double inf = std::numeric_limits<double>::infinity();
+  for (uint16_t opcode : {OP_BERNOULLI_LPMF, OP_ORDERED_LOGISTIC_LPMF}) {
+    const Kernel* kernel = find_kernel(opcode);
+    const bool tail = opcode == OP_ORDERED_LOGISTIC_LPMF;
+    for (int n : {0, 1, 2, 3, 4, 6, 7, 8, 9, 16, 17, 59, 128})
+      for (int aoff = 0; aoff < 8; ++aoff)
+        for (int soff = 0; soff < 8; ++soff)
+          for (double seed : {0.0, -0.0, 1.3, -2.7, inf}) {
+            alignas(64) double adj[144], scratch[144];
+            std::fill(std::begin(adj), std::end(adj), 12345.0);
+            std::fill(std::begin(scratch), std::end(scratch), -77.0);
+            double* const partials = scratch + soff + (tail ? 1 : 0);
+            for (int i = 0; i < n; ++i) {
+              adj[aoff + i] = 0.2 * (i % 5 - 2);
+              partials[i] = 0.1 * (i % 7 - 3);
+            }
+            partials[n] = 1.0;
+            const std::vector<double> initial(adj, adj + 144);
+            KernelCtx ctx{};
+            ctx.n_in = tail ? 2 : 1;
+            ctx.out = Desc{nullptr, 1};
+            ctx.in[0] = Desc{nullptr, tail ? 1 : n};
+            ctx.in[1] = Desc{nullptr, n};
+            const int active_arg = tail ? 1 : 0;
+            ctx.in_adj[active_arg] = Desc{adj + aoff, n};
+            ctx.scratch = scratch + soff;
+            ctx.out_adj = seed;
+            ctx.out_adj_vec = Desc{&ctx.out_adj, 1};
+            int marker = -1;
+            ctx.idata = &marker;
+            ctx.n_idata = 1;
+            for (int repeat = 0; repeat < 2; ++repeat) kernel->backward(ctx);
+            for (int i = 0; i < 144; ++i) {
+              double want = initial[i];
+              if (i >= aoff && i < aoff + n)
+                for (int repeat = 0; repeat < 2; ++repeat)
+                  want += seed * partials[i - aoff];
+              if (std::isnan(want))
+                expect_nan("retained density nonfinite", adj[i], want);
+              else
+                expect_bits("retained density pullback/guard", adj[i], want);
+            }
+            if (kernel->cached_micro) {
+              const std::vector<double> expected(adj, adj + 144);
+              std::vector<BwdMicro> micro;
+              const bool eligible = kernel->cached_micro(ctx, micro);
+              expect_true("density micro cell bound", eligible == (n <= 4));
+              if (eligible) {
+                expect_true("density micro cell count", micro.size() == size_t(n));
+                std::copy(initial.begin(), initial.end(), adj);
+                for (int repeat = 0; repeat < 2; ++repeat)
+                  for (const auto& step : micro) run_bwd_micro(step);
+                for (int i = 0; i < 144; ++i) {
+                  if (std::isnan(expected[i]))
+                    expect_nan("cached density nonfinite", adj[i], expected[i]);
+                  else
+                    expect_bits("cached density accumulation", adj[i], expected[i]);
+                }
+                partials[n] = 0.0;
+                std::copy(initial.begin(), initial.end(), adj);
+                ctx.out_adj = inf;
+                for (const auto& step : micro) run_bwd_micro(step);
+                for (int i = 0; i < 144; ++i)
+                  expect_bits("cached density disconnect", adj[i], initial[i]);
+              } else {
+                expect_true("density micro transactional refusal", micro.empty());
+              }
+            }
+            partials[n] = 0.0;
+            std::copy(initial.begin(), initial.end(), adj);
+            ctx.out_adj = inf;
+            kernel->backward(ctx);
+            for (int i = 0; i < 144; ++i)
+              expect_bits("disconnected retained density", adj[i], initial[i]);
+          }
+  }
+}
+
 int main() {
+  check_retained_density_pullbacks();
   check_scalar_poisson_lcdf();
   check_wiener_single_evaluation();

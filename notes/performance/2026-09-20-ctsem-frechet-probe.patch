+from pathlib import Path
+import sys,subprocess,json,random,math,statistics,importlib.util
+root=Path.cwd();c=root/'.cache/ctsem-remaining';out=c/'frechet';out.mkdir(exist_ok=True)
+spec=importlib.util.spec_from_file_location('hp',root/'tools/matrix_pullback_hp_check.py');hp=importlib.util.module_from_spec(spec);spec.loader.exec_module(hp);mp=hp.mpmath
+rng=random.Random(20260920);cases=[]
+def append(name,a,g):cases.append({'name':name,'n':len(a),'a':a,'g':g})
+def eye(n,value):return [[value if i==j else 0. for j in range(n)] for i in range(n)]
+for n in [1,2,5,10,20]:
+ for scale in [0.01,0.5,4.]:
+  append(f'random-{n}-{scale}',[[rng.uniform(-scale,scale) for j in range(n)]for i in range(n)],[[rng.uniform(-.5,.5)for j in range(n)]for i in range(n)])
+for n in [1,2,5,10]:
+ for off in [1.,100.,10000.]:
+  a=eye(n,-1.);g=[[rng.uniform(-.5,.5)for j in range(n)]for i in range(n)]
+  for i in range(n-1):a[i][i+1]=off
+  append(f'jordan-{n}-{off}',a,g)
+ for diagonal in [0.,-100.,100.]:
+  append(f'diagonal-{n}-{diagonal}',eye(n,diagonal),[[rng.uniform(-.5,.5)for j in range(n)]for i in range(n)])
+ append(f'zero-seed-{n}',eye(n,1.),eye(n,0.))
+ append(f'nilpotent-{n}',[[1. if j==i+1 else 0. for j in range(n)]for i in range(n)],eye(n,1.))
+(out/'cases.json').write_text(json.dumps(cases,indent=2))
+p=out/'cases.txt'
+with p.open('w')as f:
+ f.write(str(len(cases))+'\n')
+ for x in cases:
+  f.write(f"matrix_exp {x['n']}\n")
+  for a in [x['a'],x['g']]:
+   for row in a:f.write(' '.join(repr(v) for v in row)+'\n')
+r=subprocess.run([str(c/'frechet-probe'),str(p)],capture_output=True,text=True,check=True);(out/'dump.txt').write_text(r.stdout)
+values=list(map(float,r.stdout.split()));idx=0;rows=[]
+for case in cases:
+ n=case['n'];old=values[idx:idx+n*n];new=values[idx+n*n:idx+2*n*n];idx+=2*n*n
+ # Use exact binary64 inputs for the high precision calculation.
+ ref=hp.matrix_exp_reference(mp.matrix(case['a']),mp.matrix(case['g']));scale=max(abs(v)for v in ref);den=scale or mp.mpf(1)
+ errs=[float(max(abs(mp.mpf(xs[i*n+j])-ref[i,j])for i in range(n)for j in range(n))/den)for xs in [old,new]]
+ internal=max(abs(a-b)/(1+max(abs(a),abs(b)))for a,b in zip(old,new))
+ row={'name':case['name'],'n':n,'block_scale_error':errs[0],'frechet_scale_error':errs[1],'max_scaled_internal_error':internal,'internal_1e14_gate':internal<=1e-14,'frechet_no_worse_scale_error':errs[1]<=errs[0]}
+ rows.append(row);print(row,flush=True);(out/'oracle.json').write_text(json.dumps(rows,indent=2))

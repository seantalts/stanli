+#pragma once
+#include <Eigen/Dense>
+#include <algorithm>
+#include <cmath>
+// Experimental Al-Mohy/Higham (2009), Algorithm 6.4, equations 3.3 and
+// 6.11-6.13. No production caller. See https://eprints.maths.manchester.ac.uk/1218/.
+// Input A is already transposed for an adjoint; E is its scaled direction.
+inline Eigen::MatrixXd frechet_exp(Eigen::MatrixXd a, Eigen::MatrixXd e) {
+  using M=Eigen::MatrixXd;
+  const auto n=a.rows();if(n==0)return M(0,0);
+  const double norm=a.cwiseAbs().colwise().sum().maxCoeff();
+  const int m=norm<=0.0108?3:norm<=0.2?5:norm<=0.783?7:norm<=1.78?9:13;
+  const int s=m==13?std::max(0,static_cast<int>(std::ceil(std::log2(norm/4.74)))):0;
+  a*=std::ldexp(1.0,-s);e*=std::ldexp(1.0,-s);
+  M a2=a*a, d2=a*e+e*a, u,v,du,dv;
+  const M eye=M::Identity(n,n);
+  if(m<13) {
+    const double b3[]={120,60,12,1};
+    const double b5[]={30240,15120,3360,420,30,1};
+    const double b7[]={17297280,8648640,1995840,277200,25200,1512,56,1};
+    const double b9[]={17643225600.,8821612800.,2075673600.,302702400.,30270240.,2162160.,110880.,3960.,90.,1.};
+    const double* b=m==3?b3:m==5?b5:m==7?b7:b9;
+    M p[5],d[5];p[1]=a2;d[1]=d2;
+    if(m>=5){p[2]=a2*a2;d[2]=a2*d2+d2*a2;}
+    if(m>=7){p[3]=a2*p[2];d[3]=d2*p[2]+a2*d[2];}
+    if(m>=9){p[4]=p[2]*p[2];d[4]=d[2]*p[2]+p[2]*d[2];}
+    M w=b[1]*eye,dw=M::Zero(n,n);v=b[0]*eye;dv=M::Zero(n,n);
+    for(int j=1;j<=m/2;++j){w+=b[2*j+1]*p[j];dw+=b[2*j+1]*d[j];v+=b[2*j]*p[j];dv+=b[2*j]*d[j];}
+    u=a*w;du=e*w+a*dw;
+  } else {
+    const double b[]={64764752532480000.,32382376266240000.,7771770303897600.,1187353796428800.,129060195264000.,10559470521600.,670442572800.,33522128640.,1323241920.,40840800.,960960.,16380.,182.,1.};
+    const M a4=a2*a2,d4=a2*d2+d2*a2,a6=a2*a4,d6=d2*a4+a2*d4;
+    const M w1=b[13]*a6+b[11]*a4+b[9]*a2;
+    const M z1=b[12]*a6+b[10]*a4+b[8]*a2;
+    const M w=a6*w1+b[7]*a6+b[5]*a4+b[3]*a2+b[1]*eye;
+    const M dw=a6*(b[13]*d6+b[11]*d4+b[9]*d2)+d6*w1+b[7]*d6+b[5]*d4+b[3]*d2;
+    u=a*w;du=e*w+a*dw;
+    v=a6*z1+b[6]*a6+b[4]*a4+b[2]*a2+b[0]*eye;
+    dv=a6*(b[12]*d6+b[10]*d4+b[8]*d2)+d6*z1+b[6]*d6+b[4]*d4+b[2]*d2;
+  }
+  const Eigen::PartialPivLU<M> factor(v-u);
+  M r=factor.solve(v+u),l=factor.solve(du+dv+(du-dv)*r);
+  for(int i=0;i<s;++i){l=(r*l+l*r).eval();r=(r*r).eval();}
+  return l;
+}

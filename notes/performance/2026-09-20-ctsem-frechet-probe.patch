+#include "frechet.hpp"
+#include <stan/math/prim/fun/matrix_exp.hpp>
+#include <chrono>
+#include <cstdio>
+#include <fstream>
+#include <string>
+#include <vector>
+using M=Eigen::MatrixXd;
+static M block_method(const M& a,const M& g) {
+  const auto n=a.rows();if(!n)return M(0,0);
+  const M at=a.transpose();
+  const double anorm=at.cwiseAbs().colwise().sum().maxCoeff(),gnorm=g.cwiseAbs().colwise().sum().maxCoeff();
+  const double scale=gnorm>0?gnorm/std::max(anorm,1.):1.;
+  M block=M::Zero(2*n,2*n);block.topLeftCorner(n,n)=at;block.bottomRightCorner(n,n)=at;block.topRightCorner(n,n)=g/scale;
+  return M(stan::math::matrix_exp(block).topRightCorner(n,n)*scale);
+}
+static M direct_method(const M& a,const M& g) {
+  const auto n=a.rows();if(!n)return M(0,0);
+  const M at=a.transpose();
+  const double anorm=at.cwiseAbs().colwise().sum().maxCoeff(),gnorm=g.cwiseAbs().colwise().sum().maxCoeff();
+  const double scale=gnorm>0?gnorm/std::max(anorm,1.):1.;
+  return M(frechet_exp(at,g/scale)*scale);
+}
+static M read(std::istream& in,int n){M x(n,n);for(int i=0;i<n;++i)for(int j=0;j<n;++j)in>>x(i,j);return x;}
+static void print(const M& x){for(int i=0;i<x.rows();++i)for(int j=0;j<x.cols();++j)std::printf("%.17g\n",x(i,j));}
+int main(int argc,char** argv) {
+  if(argc!=2)return 2;
+  std::ifstream in(argv[1]);int count;in>>count;
+  for(int t=0;t<count;++t){std::string kind;int n;in>>kind>>n;if(kind!="matrix_exp")return 3;M a=read(in,n),g=read(in,n);
+    if(std::getenv("FRECHET_TIMING")){
+      for(int pair=0;pair<6;++pair)for(int turn=0;turn<2;++turn){const int candidate=(pair+turn)%2;int it=0;double sink=0;auto start=std::chrono::steady_clock::now();long long ns;
+        do{auto x=candidate?direct_method(a,g):block_method(a,g);sink+=x.size()?x(0,0):0;++it;ns=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now()-start).count();}while(ns<200000000);
+        std::printf("{\"case\":%d,\"n\":%d,\"pair\":%d,\"candidate\":%d,\"ns\":%.9g,\"sink\":%.9g}\n",t,n,pair,candidate,double(ns)/it,sink);
+      }
+    }else{print(block_method(a,g));print(direct_method(a,g));}
+  }
+}

+namespace {
+// Scalar-only experimental binding: never pretend mapped cells form a range.
+struct MappedAdjoints {
+  double* cells;
+  const int* ids;
+  double& operator[](int i) const { return cells[ids[i]]; }
+  double* operator+(int) const {
+    throw std::logic_error("mapped adjoints require scalar rules");
+  }
+  operator double*() const {
+    throw std::logic_error("mapped adjoints require scalar rules");
+  }
+};
+}
+void run_scalar_adjoint_mapped(const Program& fwd, const AdjProgram& ap,
+                               const double* val, double* adj, const int* ids) {
+  run_adjoint_impl(fwd, ap, val, MappedAdjoints{adj, ids});
